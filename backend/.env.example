# Copy this file to .env and adjust values before running in production.

# Server
PORT=3000
NODE_ENV=production
APP_URL=https://pottery.example.com

# Database (SQLite file). Use an ABSOLUTE path in production: the Prisma
# CLI (migrate) resolves a relative "file:" path relative to prisma/schema.prisma,
# while the running server resolves it relative to its working directory --
# a relative path can silently point the two at different files. An absolute
# path resolves identically for both. Example for the LXC layout in
# docs/DEPLOYMENT.md:
#   DATABASE_URL="file:/opt/pottery-logs/backend/data/pottery.db"
DATABASE_URL="file:./data/pottery.db"

# Secret used to sign the short-lived "pending 2FA" token issued between
# password check and TOTP verification. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-value

# Session cookie lifetime, in hours
SESSION_TTL_HOURS=168

# Set to "true" once the app is served over HTTPS (required in production so
# the session/CSRF cookies get the Secure flag). Keep "false" only for local
# HTTP development.
COOKIE_SECURE=true

# Allowed origin for the frontend during local development (Vite dev server).
# Not needed in production when the backend serves the built frontend itself.
DEV_CORS_ORIGIN=http://localhost:5173

# Set to "1" if the app sits behind a reverse proxy (nginx/Caddy) that
# terminates TLS, so Express trusts X-Forwarded-* headers.
TRUST_PROXY=1

# Bootstrap admin account, used only by `npm run seed:admin` to create the
# very first administrator. Not read at normal server startup.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-strong-password
